{
    "name": "api360-vscode",
    "displayName": "API360 Studio",
    "description": "Enterprise API Testing Client within VS Code",
    "version": "0.0.4",
    "publisher": "binod-singh",
    "repository": {
        "type": "git",
        "url": "https://github.com/binod12/api360-vscode"
    },
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "api360.openWorkspace",
                "title": "API360: Open Workspace"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/vscode": "^1.90.0",
        "@types/mocha": "^10.0.7",
        "@types/node": "20.x",
        "@typescript-eslint/eslint-plugin": "^7.14.1",
        "@typescript-eslint/parser": "^7.11.0",
        "eslint": "^8.57.0",
        "typescript": "^5.4.5",
        "ts-loader": "^9.5.1",
        "webpack": "^5.92.1",
        "webpack-cli": "^5.1.4",
        "@vscode/test-cli": "^0.0.9",
        "@vscode/test-electron": "^2.4.0"
    },
    "dependencies": {
        "axios": "^1.7.9"
    }
}